# Local dev (recommended): leave empty so Vite proxies /api to your Laravel app.
# Default proxy target: http://school-management.test (Laravel Herd)
# Override if needed, e.g. VITE_API_URL=http://127.0.0.1:8000 when using `php artisan serve`
VITE_API_URL=

# Production build (required): Laravel API origin, no trailing slash
# VITE_API_URL=https://api.yourschool.co.zw

# Display name in the browser title and dashboard chrome
VITE_APP_NAME=School Management

# Demo login chips are DEV-only (import.meta.env.DEV). They never ship in production builds.
