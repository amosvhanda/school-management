APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Harare

# Production: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning, SESSION_SECURE_COOKIE=true
# Deploy: php artisan config:cache && php artisan route:cache && php artisan storage:link

# SaaS licensing
# Local/dev: leave false. Production defaults to true when APP_ENV=production
# unless LICENSE_ENFORCEMENT is set explicitly.
LICENSE_ENFORCEMENT=false
LICENSE_GRACE_DAYS=7
LICENSE_KEY_PREFIX=SKERP
# LICENSE_CURRENCY=USD
# LICENSE_PRICE_ANNUAL=449
# LICENSE_PRICE_MONTHLY=49
# LICENSE_PRICE_QUARTERLY=129
# LICENSE_PRICE_LIFETIME=2500

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Use file cache with SQLite — database cache locks under parallel API requests (dashboard widgets).
CACHE_STORE=file
CACHE_PREFIX=

# Explicit prefixes keep cache/session keys stable across Laravel upgrades.
# SESSION_COOKIE=
# REDIS_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AUDIT_ENABLED=true

VITE_APP_NAME="${APP_NAME}"

# Frontend SPA origins allowed by CORS (comma-separated)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Sanctum stateful domains for cookie auth (token auth uses Bearer header)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173

# Laravel AI SDK (https://laravel.com/docs/13.x/ai-sdk)
# Required for full AI replies in /assistant (without it, local school-data mode is used)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=




# --- Production checklist (uncomment / set for deploy) ---
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=warning
# APP_TIMEZONE=Africa/Harare
# SESSION_SECURE_COOKIE=true
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# FRONTEND_URL=https://your-frontend.example
# SANCTUM_STATEFUL_DOMAINS=your-frontend.example
# LICENSE_ENFORCEMENT=true
# (Also auto-enabled when APP_ENV=production unless LICENSE_ENFORCEMENT is set)
# Then: php artisan config:cache && php artisan route:cache && php artisan view:cache
# Queue worker: php artisan queue:work --queue=notifications,default
# Notifications: php artisan notifications:process  (dispatches per-school jobs)

# --- SMS (Africa's Talking / Twilio / log) ---
# SMS_ENABLED=true
# SMS_PROVIDER=log
# SMS_TWILIO_SID=
# SMS_TWILIO_TOKEN=
# SMS_TWILIO_FROM=

# --- WhatsApp (Twilio) ---
# WHATSAPP_ENABLED=true
# WHATSAPP_PROVIDER=twilio
# WHATSAPP_TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_TWILIO_TOKEN=your_auth_token_from_twilio_console
# WHATSAPP_TWILIO_FROM=whatsapp:+14155238886
# Optional Content Template (Twilio WhatsApp templates):
# WHATSAPP_TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_TWILIO_CONTENT_VARIABLES={"1":"12/1","2":"3pm"}
# WHATSAPP_TWILIO_USE_TEMPLATE=false
