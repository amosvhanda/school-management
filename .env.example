APP_NAME="School ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Harare

# Production: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning
# FORCE_HTTPS=true behind TLS terminators; SESSION_SECURE_COOKIE=true
# Deploy: php artisan migrate --force && php artisan db:seed --class=ProductionSeeder --force
#         php artisan config:cache && php artisan route:cache && php artisan view:cache && php artisan storage:link
#         php artisan queue:work

FORCE_HTTPS=false
TRUSTED_PROXIES=

# SaaS licensing (set true in production)
LICENSE_ENFORCEMENT=false
LICENSE_GRACE_DAYS=7
LICENSE_KEY_PREFIX=SKERP

# Online gateway (keep false until Paynow/EcoCash is fully integrated)
PAYMENT_GATEWAY_LIVE=false
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Optional email verification gate (requires MustVerifyEmail on User)
EMAIL_VERIFICATION_REQUIRED=false

# Never set SEED_DEMO_DATA=true in production
SEED_DEMO_DATA=false

# ProductionSeeder (used when APP_ENV=production)
# PROD_SCHOOL_NAME="Harare High School"
# PROD_SCHOOL_CODE=HHS01
# PROD_ADMIN_EMAIL=admin@school.example
# PROD_ADMIN_PASSWORD=
# PROD_ADMIN_NAME="School Administrator"
# PROD_SUPER_ADMIN_EMAIL=
# PROD_SUPER_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Use file cache with SQLite — database cache locks under parallel API requests (dashboard widgets).
CACHE_STORE=file
CACHE_PREFIX=

# Explicit prefixes keep cache/session keys stable across Laravel upgrades.
# SESSION_COOKIE=
# REDIS_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@school.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AUDIT_ENABLED=true

VITE_APP_NAME="${APP_NAME}"

# Frontend SPA origins allowed by CORS (comma-separated)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Sanctum stateful domains for cookie auth (token auth uses Bearer header)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173

# Laravel AI SDK (optional — without it, local school-data assistant mode is used)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Production checklist ---
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=warning
# APP_URL=https://api.yourschool.co.zw
# FORCE_HTTPS=true
# TRUSTED_PROXIES=*
# SESSION_SECURE_COOKIE=true
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# MAIL_MAILER=smtp
# FRONTEND_URL=https://app.yourschool.co.zw
# SANCTUM_STATEFUL_DOMAINS=app.yourschool.co.zw
# LICENSE_ENFORCEMENT=true
# PAYMENT_GATEWAY_LIVE=false
# See docs/PRODUCTION.md
